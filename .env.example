# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- DreamLab API -----------------------------------------------------------
DREAMLAB_API_KEY=
DREAMLAB_BASE_URL=https://api.dreamlabs.ai

# --- Web control panel ------------------------------------------------------
# The website can move the robot. Set a token so only people who know it can
# press buttons. Leave empty only on a private, trusted network.
ORBOH_WEB_TOKEN=

# --- Optional overrides -----------------------------------------------------
# ORBOH_CONFIG=config/pipeline.yaml
# MUJOCO_GL=egl          # default is egl (set by orboh.sim); osmesa for CPU-only. Never 'glfw': it can capture the desktop

